rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own profile, anyone logged in can read users
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Peladas can be read by anyone so visitors/players can view groups and games
    // Writing requires authentication
    match /peladas/{peladaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // App data (players list, group config) is readable by everyone and updatable by authenticated users
    match /app_data/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Fallback rule for other documents
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

